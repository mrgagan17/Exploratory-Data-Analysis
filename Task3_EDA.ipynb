import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

%matplotlib inline

netflix = pd.read_csv("netflix_titles.csv")
netflix.head()
netflix.info()

plt.figure(figsize=(8,5))
sns.histplot(netflix['release_year'], bins=20)
plt.title("Distribution of Release Year")
plt.show()

plt.figure(figsize=(6,4))
sns.countplot(x='type', data=netflix)
plt.title("Movies vs TV Shows")
plt.show()

top_countries = netflix['country'].value_counts().head(10)

plt.figure(figsize=(8,5))
sns.barplot(x=top_countries.values, y=top_countries.index)
plt.title("Top 10 Content Producing Countries")
plt.show()

iris = pd.read_csv("iris.csv")
iris.head()

iris.info()

iris.hist(figsize=(10,8))
plt.show()

plt.figure(figsize=(8,5))
sns.boxplot(data=iris.drop('species', axis=1))
plt.title("Box Plot for Outlier Detection")
plt.show()

plt.figure(figsize=(8,6))
sns.heatmap(iris.drop('species', axis=1).corr(), annot=True, cmap='coolwarm')
plt.title("Correlation Heatmap")
plt.show()

iris.corr()

print("""
Key Findings:
1. Netflix content has increased rapidly after 2000
2. Movies are more than TV Shows
3. USA dominates Netflix content
4. Petal features are most important in Iris dataset
5. Strong correlation exists between petal length and width
""")
